#!/bin/sh
set -e
NAME="vca2-vcass-node"
VERSION="2.3.26+ubuntu24.04.10"
case "$1" in
  remove|deconfigure)
    systemctl disable --now vca_agent.service >/dev/null 2>&1 || true
    if command -v dkms >/dev/null 2>&1; then
      dkms remove -m "$NAME" -v "$VERSION" --all || true
    fi
    depmod -a || true
    ;;
esac
exit 0
